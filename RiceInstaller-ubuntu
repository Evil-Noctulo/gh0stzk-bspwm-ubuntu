}
# ─────────────────────────────────────────────────────────────────
initial_checks() {
    log "--- initial_checks ---"

    if [ "$(id -u)" = 0 ]; then
        log "FALLO: script ejecutado como root"
        printf "Este script NO debe ejecutarse como usuario root."
        exit 1
    fi

    if [ "$PWD" != "$HOME" ]; then
        log "FALLO: PWD=$PWD is not HOME=$HOME"
        printf "El script debe ejecutarse desde el directorio HOME."
        exit 1
    fi

    if ! command -v apt >/dev/null 2>&1; then
        log "FALLO: apt no encontrado — no es Ubuntu/Debian"
        printf "Este script requiere apt (Ubuntu/Debian). Saliendo.\n"
        exit 1
    fi

    log "Verificaciones iniciales OK"
}

