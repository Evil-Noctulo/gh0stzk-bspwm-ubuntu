    # Imprime el arte ASCII tal cual, sin interpretar caracteres especiales
    cat << 'EOF'
        ______      _ __   _   __           __        __                  _______ __              ______                      __
       / ____/   __(_) /  / | / /___  _____/ /___  __/ /___              / ____(_) /_  ___  _____/ ____/___  ________   _____/ /
      / __/ | | / / / /  /  |/ / __ \/ ___/ __/ / / / / __ \   ______   / /   / / __ \/ _ \/ ___/ /   / __ \/ ___/ _ \ / ___/ / 
     / /___ | |/ / / /  / /|  / /_/ / /__/ /_/ /_/ / / /_/ /  /_____/  / /___/ / /_/ /  __/ /  / /___/ /_/ / /  /  __// /__/ /  
    /_____/ |___/_/_/  /_/ |_/\____/\___/\__/\__,_/_/\____/            \____/_/_.___/\___/_/   \____/\____/_/   \___(_)___/_/   
                                                                                                                            
