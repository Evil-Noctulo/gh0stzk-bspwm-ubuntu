# ─────────────────────────────────────────────────────────────────
# Equivalent of add_gh0stzk_repo + add_chaotic_repo
add_repos() {
    clear
    logo "Agregando repositorios"
    sleep 2

    printf "%b\n" "${BLD}${CYE}Habilitar el repositorio universe y añadir los PPAs necesarios...${CNC}"

    run sudo add-apt-repository universe -y

    # Neovim PPA — equivalent to Arch's neovim package
    if ! grep -rq "neovim-ppa" /etc/apt/sources.list.d/ 2>/dev/null; then
        printf "%b\n" "${BLD}${CYE}Añadieno Neovim PPA...${CNC}"
        run sudo add-apt-repository ppa:neovim-ppa/stable -y
    else
        printf "\n%b\n" "${BLD}${CYE}PPA de Neovim ya configurado${CNC}"
        log "PPA de Neovim ya presente, saltando."
    fi

    # Alacritty PPA — not in Ubuntu 22.04 universe by default
    if ! grep -rq "aslatter" /etc/apt/sources.list.d/ 2>/dev/null; then
        printf "%b\n" "${BLD}${CYE}Añadiendo Alacritty PPA...${CNC}"
        run sudo add-apt-repository ppa:aslatter/ppa -y
    else
        printf "\n%b\n" "${BLD}${CYE}Alacritty PPA ya configurado${CNC}"
        log "PPA de Alacritty ya presente, saltando."
    fi

    run sudo apt update
    printf "\n%b\n" "${BLD}${CGR}Repositorios configurado correctamente!${CNC}"
    sleep 3
}

# ─────────────────────────────────────────────────────────────────
# Equivalent of install_dependencies() — all packages via apt
# Arch->Ubuntu name mappings documented inline
install_apt_dependencies() {
    clear
    logo "Instalando paquetes necesarios desde apt..."
    sleep 2

    run sudo apt update

    # Arch -> Ubuntu mappings:
    #   base-devel            -> build-essential
    #   python-gobject        -> python3-gi
    #   xorg-xdpyinfo         -> xdpyinfo
    #   xorg-xkill            -> x11-utils  (also has xprop, xwininfo)
    #   xorg-xrandr           -> x11-xserver-utils  (also has xsetroot, xrdb)
    #   ttf-inconsolata       -> fonts-inconsolata
    #   ttf-jetbrains-mono    -> fonts-jetbrains-mono
    #   webp-pixbuf-loader    -> webp-pixbuf-loader  (same name)
    #   gvfs-mtp              -> gvfs-backends  (includes MTP)
    #   pacman-contrib        -> N/A (Arch-only, omitted)
    #   eza, clipcat, yazi, xcolor, xdo, xwinwrap, i3lock-color, fzf-tab, eww, rustup
    #     -> handled in dedicated functions below
    #   ttf-*-nerd            -> downloaded from nerd-fonts releases
    # Fixes from log analysis:
    #   simple-mtpfs        -> jmtpfs  (simple-mtpfs not in Ubuntu 24.04 noble)
    #   xdpyinfo            -> x11-apps  (xdpyinfo is bundled here in noble)
    #   zsh-history-substring-search -> NOT in noble; cloned from git in install_zsh_plugins()
    #   libxcb-xrm-dev      -> ADDED (was missing, caused i3lock-color configure failure)
    dependencies="alacritty bat brightnessctl bspwm build-essential cmake curl \
dunst feh fzf geany git gvfs-backends imagemagick jq jgmenu kitty lxsession \
maim mpc mpd mpv ncmpcpp neovim nodejs npm pamixer papirus-icon-theme picom \
playerctl polybar python3-gi redshift rofi jmtpfs sxhkd thunar tumbler \
pass webp-pixbuf-loader wget unzip zstd xclip xdg-user-dirs x11-apps xdotool \
x11-utils x11-xserver-utils xsettingsd zsh zsh-autosuggestions \
zsh-syntax-highlighting \
fonts-inconsolata fonts-jetbrains-mono \
autoconf automake pkg-config libev-dev \
libx11-dev libxext-dev libxft-dev libxinerama-dev libxrandr-dev \
libxi-dev libxrender-dev libxcomposite-dev libxcb1-dev libxcb-util0-dev \
libxcb-xinerama0-dev libxcb-randr0-dev libxcb-image0-dev libxcb-shape0-dev \
libxcb-composite0-dev libxcb-xrm-dev libxkbcommon-dev libxkbcommon-x11-dev \
libpam0g-dev libcairo2-dev libjpeg-dev libimlib2-dev libglib2.0-dev libgtk-3-dev \
libgdk-pixbuf2.0-dev libpango1.0-dev libdbusmenu-gtk3-dev"

    # Install all packages in a single apt call — one dependency resolution pass,
    # one download queue, orders of magnitude faster than one-by-one.
    # Packages that don't exist will cause the whole call to fail, so we catch
    # that, identify the bad ones individually, then retry the good ones together.
    failed_deps=""
    retry_failed=""

    log "Instalación en lote de apt — inicio (${#dependencies} paquetes)"
    printf "%b\n" "${BLD}${CYE}Ejecutando instalación en lote...${CNC}"

    # shellcheck disable=SC2086
    if ! sudo apt install -y $dependencies >> "$LOG_FILE" 2>&1; then
        log "La instalación en lote falló — identificando paquetes problemáticos uno por uno"
        printf "%b\n" "${BLD}${CYE}Lote fallido, identificando paquetes con problemas...${CNC}"

        for pkg in $dependencies; do
            if ! sudo apt install -y "$pkg" >> "$LOG_FILE" 2>&1; then
                log "FAILED (first attempt): $pkg"
                failed_deps="$failed_deps $pkg"
            else
                log "OK: $pkg"
            fi
        done
    else
        log "Batch install OK"
    fi

    if [ -n "$failed_deps" ]; then
        printf "\n%b\n" "${BLD}${CRE}Estas dependencias fallaron:${CYE}${failed_deps}${CNC}"
        printf "%b\n\n" "${BLD}${CYE}Reintentando instalación..${CNC}"
        log "RETRY pass for:$failed_deps"

        for pkg in $failed_deps; do
            log "APT retry: $pkg"
            if ! sudo apt install -y "$pkg" >> "$LOG_FILE" 2>&1; then
                log "FALLÓ (segundo intento): $pkg"
                retry_failed="$retry_failed $pkg"
            else
                log "OK al reintentar: $pkg"
            fi
        done
    fi

    if [ -n "$retry_failed" ]; then
        printf "\n%b\n" "${BLD}${CRE}Estas dependencias no pudieron instalarse tras dos intentos:${CYE}${retry_failed}${CNC}"
        printf "%b\n\n" "${BLD}${CBL}~/Entorno/missing_apps.txt ${CYE}fue creado con la lista de fallos."
        printf "Las siguientes dependencias fallaron, instálalas manualmente:\n%s\n" "$retry_failed" > "$HOME/missing_apps.txt"
        log "ESCRITO missing_apps.txt:$retry_failed"
    else
        if [ -z "$failed_deps" ]; then
            printf "\n%b\n" "${BLD}${CGR}Todas las dependencias se instalaron exitosamente.${CNC}"
        else
            printf "\n%b\n" "${BLD}${CGR}Todas las dependencias se instalaron exitosamente al reintentar${CNC}"
        fi
    fi

    # Ubuntu installs bat as 'batcat' — create symlink so dotfile configs work
    if ! command -v bat >/dev/null 2>&1 && command -v batcat >/dev/null 2>&1; then
        mkdir -p "$HOME/.local/bin"
        ln -sf "$(command -v batcat)" "$HOME/.local/bin/bat"
        log "Symlink creado: bat -> $(command -v batcat)"
        printf "%b\n" "${BLD}${CYE}Creado symlink bat -> batcat en ~/.local/bin${CNC}"
    fi

    sleep 3
}

# ─────────────────────────────────────────────────────────────────
# Fix: Ubuntu no incluye el terminfo de alacritty.
# Sin él, tput falla con "unknown terminal alacritty", rompiendo todos
# los colores del prompt y corrompiendo el autocompletado de zsh.
install_alacritty_terminfo() {
    clear
    logo "Instalando terminfo de Alacritty..."
    sleep 2

    # Verificar si ya está instalado
    if infocmp alacritty >/dev/null 2>&1; then
        printf "%b\n" "${BLD}${CGR}Terminfo de Alacritty ya instalado.${CNC}"
        log "Terminfo alacritty ya presente, saltando."
        sleep 3
        return
    fi

    printf "%b\n" "${BLD}${CYE}Descargando terminfo de Alacritty...${CNC}"
    log "Descargando alacritty.info desde el repo oficial"

    if run curl -fL https://raw.githubusercontent.com/alacritty/alacritty/master/extra/alacritty.info \
            -o /tmp/alacritty.info; then
        if run sudo tic -xe alacritty,alacritty-direct /tmp/alacritty.info; then
            rm -f /tmp/alacritty.info
            log "OK: terminfo de alacritty instalado"
            printf "%b\n" "${BLD}${CGR}Terminfo de Alacritty instalado correctamente.${CNC}"
        else
            log "ERROR: fallo al compilar terminfo de alacritty"
            printf "%b\n" "${BLD}${CRE}Fallo al compilar terminfo. Revisa missing_apps.txt${CNC}"
            printf "\nalacritty terminfo: instalar manualmente:\n  curl -fL https://raw.githubusercontent.com/alacritty/alacritty/master/extra/alacritty.info -o /tmp/alacritty.info\n  sudo tic -xe alacritty,alacritty-direct /tmp/alacritty.info\n" >> "$HOME/missing_apps.txt"
        fi
    else
        log "ERROR: fallo al descargar alacritty.info"
        printf "%b\n" "${BLD}${CRE}No se pudo descargar alacritty.info. Revisa missing_apps.txt${CNC}"
        printf "\nalacritty terminfo: descargar manualmente desde https://github.com/alacritty/alacritty\n" >> "$HOME/missing_apps.txt"
    fi

    sleep 3
}

# ─────────────────────────────────────────────────────────────────
# Equivalent of the rustup package from Arch official repos.
# Ubuntu's rustup in apt can be outdated; install from rustup.rs.
install_rustup() {
    clear
    logo "Instalando cadena de herramientas Rust"
    sleep 2

    if ! command -v rustup >/dev/null 2>&1; then
        printf "%b\n" "${BLD}${CYE}Instalando rustup desde rustup.rs...${CNC}"
        log "Descargando y ejecutando el instalador de rustup"
        run curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path
        printf "%b\n" "${BLD}${CGR}Rust instalado exitosamente.${CNC}"
    else
        printf "%b\n" "${BLD}${CGR}Rust ya está instalado.${CNC}"
        log "rustup ya presente, ejecutando actualización"
        run rustup update stable
    fi

    . "$HOME/.cargo/env"
    log "Versión de Rust: $(rustc --version 2>&1)"
    sleep 3
}

# ─────────────────────────────────────────────────────────────────
# Equivalent of clipcat + xcolor from gh0stzk/chaotic repo:
# neither exists as an Ubuntu package — build via cargo.
install_cargo_tools() {
    clear
    logo "Instalando herramientas cargo (clipcat, xcolor)..."
    sleep 2

    . "$HOME/.cargo/env" 2>/dev/null || export PATH="$HOME/.cargo/bin:$PATH"

    cargo_tools="clipcat xcolor"
    failed_cargo_deps=""
    retry_cargo_failed=""

    for tool in $cargo_tools; do
        sleep 0.50
        if ! command -v "$tool" >/dev/null 2>&1; then
            printf "%b\n" "${BLD}${CYE}Instalando ${tool}...${CNC}"
            log "cargo install $tool — inicio"
            if ! run cargo install "$tool"; then
                log "FALLÓ (primer intento): cargo install $tool"
                failed_cargo_deps="$failed_cargo_deps $tool"
            else
                log "OK: cargo install $tool"
            fi
        else
            printf "%b\n" "${BLD}${CGR}${tool} ya está instalado.${CNC}"
            log "$tool ya instalado, saltando."
        fi
    done

    if [ -n "$failed_cargo_deps" ]; then
        printf "\n%b\n" "${BLD}${CRE}Estas herramientas cargo fallaron:${CYE}${failed_cargo_deps}${CNC}"
        printf "%b\n\n" "${BLD}${CYE}Reintentando instalación..${CNC}"
        log "REINTENTO cargo para:$failed_cargo_deps"

        for tool in $failed_cargo_deps; do
            sleep 0.50
            log "cargo retry: $tool"
            if ! run cargo install "$tool"; then
                log "FALLÓ (segundo intento): cargo install $tool"
                retry_cargo_failed="$retry_cargo_failed $tool"
            else
                log "OK al reintentar: $tool"
            fi
        done
    fi

    if [ -n "$retry_cargo_failed" ]; then
        printf "\n%b\n" "${BLD}${CRE}Estos no pudieron instalarse tras dos intentos:${CYE}${retry_cargo_failed}${CNC}"
        printf "%b\n\n" "${BLD}${CBL}~/Entorno/missing_apps.txt ${CYE}fue creado con la lista de fallos."
        printf "\nHerramientas Cargo\n=======================\nInstalar con: cargo install <herramienta>\nFallaron:\n%s\n" "$retry_cargo_failed" >> missing_apps.txt
    else
        if [ -z "$failed_cargo_deps" ]; then
            printf "\n%b\n" "${BLD}${CGR}Todas las herramientas cargo instaladas exitosamente.${CNC}"
        else
            printf "\n%b\n" "${BLD}${CGR}Todas las herramientas cargo instaladas exitosamente al reintentar${CNC}"
        fi
    fi

    sleep 3
}

# ─────────────────────────────────────────────────────────────────
# Equivalent of eww-git from chaotic-aur:
# not available on Ubuntu — build from source with cargo.
install_eww() {
    clear
    logo "Compilando eww desde fuente..."
    sleep 2

    . "$HOME/.cargo/env" 2>/dev/null || export PATH="$HOME/.cargo/bin:$PATH"

    if command -v eww >/dev/null 2>&1; then
        printf "%b\n" "${BLD}${CGR}eww ya está instalado.${CNC}"
        log "eww ya instalado, saltando compilación."
        sleep 3
        return
    fi

    printf "%b\n" "${BLD}${CYE}Clonando eww...${CNC}"
    [ -d /tmp/eww ] && rm -rf /tmp/eww
    run git clone --depth=1 https://github.com/elkowar/eww /tmp/eww
    cd /tmp/eww || { log "ERROR: no se pudo acceder a /tmp/eww"; return 1; }

    printf "%b\n" "${BLD}${CYE}Compilando eww (esto puede tardar varios minutos)...${CNC}"
    log "cargo build eww — inicio"
    if run cargo build --release --no-default-features --features x11; then
        run sudo mv target/release/eww /usr/local/bin/eww
        log "eww instalado en /usr/local/bin/eww"
        printf "%b\n" "${BLD}${CGR}eww instalado exitosamente.${CNC}"
    else
        log "ERROR: fallo en cargo build de eww"
        printf "%b\n" "${BLD}${CRE}La compilación de eww falló. Revisa missing_apps.txt${CNC}"
        printf "\neww\n=======================\nCompilar desde: https://github.com/elkowar/eww\n" >> "$HOME/missing_apps.txt"
    fi

    cd "$HOME"
    rm -rf /tmp/eww
    sleep 3
}

# ─────────────────────────────────────────────────────────────────
# Equivalent of install_aur_dependencies():
#   xdo           — build from source (baskerville/xdo)
#   i3lock-color  — build from source (Raymo111/i3lock-color)
#   xwinwrap      — build from source (ujjwal96/xwinwrap)
#   simple-mtpfs  — apt (already handled above)
#   fzf-tab-git   — handled in install_fzf_tab()
install_source_builds() {
    clear
    logo "Compilando paquetes desde fuente (xdo, i3lock-color, xwinwrap)..."
    sleep 2

    failed_src_deps=""
    retry_src_failed=""

    # --- xdo ---
