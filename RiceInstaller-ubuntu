# ─────────────────────────────────────────────────────────────────
# Equivalent of ttf-jetbrains-mono-nerd, ttf-terminus-nerd,
# ttf-ubuntu-mono-nerd from Arch official repos.
# Not packaged for Ubuntu — download from ryanoasis/nerd-fonts releases.
install_nerd_fonts() {
    clear
    logo "Instalando Nerd Fonts..."
    sleep 2

    fonts_dir="$HOME/.local/share/fonts"
    mkdir -p "$fonts_dir"

    nerd_fonts="JetBrainsMono Terminus UbuntuMono"
    NF_BASE="https://github.com/ryanoasis/nerd-fonts/releases/latest/download"

    failed_font_deps=""
    retry_font_failed=""

    for font in $nerd_fonts; do
        sleep 0.50
        font_dir="${fonts_dir}/${font}NerdFont"
        if ls "${font_dir}"/*.ttf >/dev/null 2>&1; then
            printf "%b\n" "${BLD}${CGR}Nerd Font ${font} ya está instalada.${CNC}"
            log "Nerd Font $font ya presente, saltando."
            continue
        fi
        printf "%b\n" "${BLD}${CYE}Descargando Nerd Font ${font}...${CNC}"
        log "Descargando ${font} desde ${NF_BASE}/${font}.zip"
        mkdir -p "$font_dir"
        if run curl -fL "${NF_BASE}/${font}.zip" -o "/tmp/${font}.zip"; then
            unzip -o "/tmp/${font}.zip" -d "$font_dir" '*.ttf' '*.otf' >/dev/null 2>&1
            rm -f "/tmp/${font}.zip"
            log "OK: Nerd Font $font instalada"
            printf "%b\n" "${BLD}${CGR}Nerd Font ${font} instalada.${CNC}"
        else
            log "FALLÓ (primer intento): Nerd Font $font"
            printf "%b\n" "${BLD}${CRE}Falló la descarga de Nerd Font ${font}.${CNC}"
            failed_font_deps="$failed_font_deps $font"
            rm -rf "$font_dir"
        fi
    done

    if [ -n "$failed_font_deps" ]; then
        printf "\n%b\n" "${BLD}${CRE}${BLD}${CRE}Estas fuentes fallaron:${CYE}${failed_font_deps}${CNC}"
        printf "%b\n\n" "${BLD}${CYE}Reintentando...${CNC}"
        log "REINTENTO fuentes para:$failed_font_deps"

        for font in $failed_font_deps; do
            sleep 0.50
            font_dir="${fonts_dir}/${font}NerdFont"
            mkdir -p "$font_dir"
            if run curl -fL "${NF_BASE}/${font}.zip" -o "/tmp/${font}.zip"; then
                unzip -o "/tmp/${font}.zip" -d "$font_dir" '*.ttf' '*.otf' >/dev/null 2>&1
                rm -f "/tmp/${font}.zip"
                log "OK al reintentar: Nerd Font $font"
            else
                log "FALLÓ (segundo intento): Nerd Font $font"
                retry_font_failed="$retry_font_failed $font"
                rm -rf "$font_dir"
            fi
        done
    fi

    run fc-cache -f "$fonts_dir"

    if [ -n "$retry_font_failed" ]; then
        printf "\n%b\n" "${BLD}${CRE}Estas fuentes no pudieron instalarse tras dos intentos:${CYE}${retry_font_failed}${CNC}"
        printf "%b\n\n" "${BLD}${CBL}~/Entorno/missing_apps.txt ${CYE}fue creado con la lista de fallos."
        printf "\nNerd Fonts (descargar desde https://www.nerdfonts.com/font-downloads):\n%s\n" "$retry_font_failed" >> missing_apps.txt
    else
        if [ -z "$failed_font_deps" ]; then
            printf "\n%b\n" "${BLD}${CGR}Todas las Nerd Fonts instaladas exitosamente.${CNC}"
        else
            printf "\n%b\n" "${BLD}${CGR}Todas las Nerd Fonts instaladas exitosamente al reintentar${CNC}"
        fi
    fi

    sleep 3
}

# ─────────────────────────────────────────────────────────────────
# Equivalent of install_gh0stzk_dependencies() for data packages
# (themes, icons, cursor). Hosted as Arch .pkg.tar.zst archives at
# gh0stzk.github.io/pkgs/x86_64 — we parse the DB and extract them.
# Binary package st-gh0stzk is handled separately in build_st().
install_gh0stzk_packages() {
    clear
    logo "Instalando temas, iconos y cursor de gh0stzk..."
    sleep 2

    repo_url="http://gh0stzk.github.io/pkgs/x86_64"
    db_tmp="/tmp/gh0stzk.db"

    printf "%b\n" "${BLD}${CYE}Obteniendo lista de paquetes gh0stzk...${CNC}"
    log "Obteniendo DB de paquetes desde $repo_url/gh0stzk-dotfiles.db"

    if ! run curl -sf "$repo_url/gh0stzk-dotfiles.db" -o "$db_tmp"; then
        log "ERROR: no se pudo acceder al repo gh0stzk — temas/iconos omitidos"
        printf "%b\n" "${BLD}${CRE}No se pudo acceder al repo gh0stzk. Temas/iconos serán omitidos.${CNC}"
        printf "\nTemas/iconos gh0stzk: instalar manualmente desde %s\n" "$repo_url" >> missing_apps.txt
        sleep 3
        return
    fi

    gh0stzk_dependencies="gh0stzk-gtk-themes gh0stzk-cursor-qogirr \
gh0stzk-icons-beautyline gh0stzk-icons-candy gh0stzk-icons-catppuccin-mocha \
gh0stzk-icons-dracula gh0stzk-icons-glassy gh0stzk-icons-gruvbox-plus-dark \
gh0stzk-icons-hack gh0stzk-icons-luv gh0stzk-icons-sweet-rainbow \
gh0stzk-icons-tokyo-night gh0stzk-icons-vimix-white gh0stzk-icons-zafiro \
gh0stzk-icons-zafiro-purple"

    failed_gh0st_deps=""
    retry_gh0st_failed=""

    for pkg in $gh0stzk_dependencies; do
        sleep 0.50
        # Arch repo DB dirs are named "pkgname-version-pkgrel", not just "pkgname".
        # First list to find the versioned dirname, then extract its desc file.
        pkg_dir=$(tar -tzf "$db_tmp" 2>/dev/null | grep "^${pkg}-[^/]*/desc$" | head -1 | sed 's|/desc$||')
        if [ -n "$pkg_dir" ]; then
            pkg_filename=$(tar -xOf "$db_tmp" "${pkg_dir}/desc" 2>/dev/null | \
                awk '/^%FILENAME%/{getline; print; exit}')
        else
            pkg_filename=""
        fi

        log "gh0stzk pkg: $pkg  dir: $pkg_dir  ->  filename: $pkg_filename"

        if [ -z "$pkg_filename" ]; then
            printf "%b\n" "${BLD}${CRE}No encontrado en la base de datos del repo: ${pkg}${CNC}"
            log "FALLÓ (no está en la DB): $pkg"
            failed_gh0st_deps="$failed_gh0st_deps $pkg"
            continue
        fi

        printf "%b\n" "${BLD}${CYE}Instalando ${pkg}...${CNC}"
        if run curl -sf "$repo_url/$pkg_filename" -o "/tmp/${pkg}.pkg.tar.zst"; then
            sudo tar -I zstd -xf "/tmp/${pkg}.pkg.tar.zst" -C / \
                --exclude='.PKGINFO' --exclude='.BUILDINFO' \
                --exclude='.MTREE'   --exclude='.CHANGELOG' \
                --exclude='.INSTALL' 2>> "$LOG_FILE"
            rm -f "/tmp/${pkg}.pkg.tar.zst"
            log "OK: $pkg instalado"
            printf "%b\n" "${BLD}${CGR}${pkg} instalado.${CNC}"
        else
            log "FALLÓ (primer intento): descarga de $pkg"
            printf "%b\n" "${BLD}${CRE}Descarga fallida: ${pkg}${CNC}"
            failed_gh0st_deps="$failed_gh0st_deps $pkg"
        fi
    done

    if [ -n "$failed_gh0st_deps" ]; then
        printf "\n%b\n" "${BLD}${CRE}These dependencies failed:${CYE}${failed_gh0st_deps}${CNC}"
        printf "%b\n\n" "${BLD}${CYE}Reintentando instalación..${CNC}"
        log "REINTENTO gh0stzk para:$failed_gh0st_deps"

        for pkg in $failed_gh0st_deps; do
            sleep 0.50
            pkg_dir=$(tar -tzf "$db_tmp" 2>/dev/null | grep "^${pkg}-[^/]*/desc$" | head -1 | sed 's|/desc$||')
            if [ -n "$pkg_dir" ]; then
                pkg_filename=$(tar -xOf "$db_tmp" "${pkg_dir}/desc" 2>/dev/null | \
                    awk '/^%FILENAME%/{getline; print; exit}')
            else
                pkg_filename=""
            fi
            if [ -n "$pkg_filename" ] && \
               run curl -sf "$repo_url/$pkg_filename" -o "/tmp/${pkg}.pkg.tar.zst"; then
                sudo tar -I zstd -xf "/tmp/${pkg}.pkg.tar.zst" -C / \
                    --exclude='.PKGINFO' --exclude='.BUILDINFO' \
                    --exclude='.MTREE'   --exclude='.CHANGELOG' \
                    --exclude='.INSTALL' 2>> "$LOG_FILE"
                rm -f "/tmp/${pkg}.pkg.tar.zst"
                log "OK al reintentar: $pkg"
            else
                log "FALLÓ (segundo intento): $pkg"
                retry_gh0st_failed="$retry_gh0st_failed $pkg"
            fi
        done
    fi

    rm -f "$db_tmp"

    if [ -n "$retry_gh0st_failed" ]; then
        printf "\n%b\n" "${BLD}${CRE}Estas dependencias no pudieron instalarse tras dos intentos:${CYE}${retry_gh0st_failed}${CNC}"
        printf "%b\n\n" "${BLD}${CBL}~/Entorno/missing_apps.txt ${CYE}fue creado con la lista de fallos."
        printf "\nApps del repo gh0stzk\n=======================\nInstalar desde: %s\nFallaron:\n%s\n" "$repo_url" "$retry_gh0st_failed" >> missing_apps.txt
    else
        if [ -z "$failed_gh0st_deps" ]; then
            printf "\n%b\n" "${BLD}${CGR}Todas las dependencias se instalaron exitosamente.${CNC}"
        else
            printf "\n%b\n" "${BLD}${CGR}Todas las dependencias se instalaron exitosamente al reintentar${CNC}"
        fi
    fi

    sleep 3
}

# ─────────────────────────────────────────────────────────────────
# Equivalent of fzf-tab-git from AUR.
# It's a zsh plugin (not a binary) — clone to ~/.local/share/fzf-tab.
install_fzf_tab() {
    clear
    logo "Instalando plugin zsh fzf-tab..."
    sleep 2

    fzf_tab_dir="$HOME/.local/share/fzf-tab"

    if [ ! -d "$fzf_tab_dir" ]; then
        printf "%b\n" "${BLD}${CYE}Clonando fzf-tab...${CNC}"
        log "Clonando fzf-tab en $fzf_tab_dir"
        if run git clone --depth=1 https://github.com/Aloxaf/fzf-tab "$fzf_tab_dir"; then
            log "OK: fzf-tab instalado"
            printf "%b\n" "${BLD}${CGR}fzf-tab instalado en ${fzf_tab_dir}.${CNC}"
        else
            log "ERROR: fallo al clonar fzf-tab"
            printf "%b\n" "${BLD}${CRE}Fallo al clonar fzf-tab.${CNC}"
            printf "\nfzf-tab: https://github.com/Aloxaf/fzf-tab\n" >> missing_apps.txt
        fi
    else
        printf "%b\n" "${BLD}${CGR}fzf-tab ya está instalado.${CNC}"
        log "fzf-tab ya presente, saltando."
    fi

    # Crear symlink en /usr/share/zsh/plugins/ para que .zshrc lo encuentre
    printf "%b\n" "${BLD}${CYE}Creando symlink de fzf-tab en /usr/share/zsh/plugins/...${CNC}"
    sudo mkdir -p /usr/share/zsh/plugins
    if run sudo ln -sf "$fzf_tab_dir" /usr/share/zsh/plugins/fzf-tab-git; then
        log "OK: symlink fzf-tab -> /usr/share/zsh/plugins/fzf-tab-git"
        printf "%b\n" "${BLD}${CGR}Symlink fzf-tab creado.${CNC}"
    else
        log "ERROR: fallo al crear symlink de fzf-tab"
        printf "%b\n" "${BLD}${CRE}Fallo al crear symlink de fzf-tab.${CNC}"
    fi

    sleep 3
}

