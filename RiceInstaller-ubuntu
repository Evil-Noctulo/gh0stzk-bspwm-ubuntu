# Clone it directly from upstream, same as fzf-tab.
install_zsh_plugins() {
    clear
    logo "Instalando plugins de zsh..."
    sleep 2

    zhs_dir="$HOME/.local/share/zsh-history-substring-search"

    if [ ! -d "$zhs_dir" ]; then
        printf "%b\n" "${BLD}${CYE}Clonando zsh-history-substring-search...${CNC}"
        log "Clonando zsh-history-substring-search en $zhs_dir"
        if run git clone --depth=1 https://github.com/zsh-users/zsh-history-substring-search "$zhs_dir"; then
            log "OK: zsh-history-substring-search instalado"
            printf "%b\n" "${BLD}${CGR}zsh-history-substring-search instalado.${CNC}"
        else
            log "ERROR: fallo al clonar zsh-history-substring-search"
            printf "%b\n" "${BLD}${CRE}Fallo al clonar zsh-history-substring-search.${CNC}"
            printf "\nzsh-history-substring-search: https://github.com/zsh-users/zsh-history-substring-search\n" >> missing_apps.txt
        fi
    else
        printf "%b\n" "${BLD}${CGR}zsh-history-substring-search ya está instalado.${CNC}"
        log "zsh-history-substring-search ya presente, saltando."
    fi

    # Crear symlinks en /usr/share/zsh/plugins/ para todos los plugins zsh
    # El .zshrc de gh0stzk los busca en esa ruta; en Ubuntu apt los instala en lugares distintos.
    printf "%b\n" "${BLD}${CYE}Creando symlinks de plugins zsh en /usr/share/zsh/plugins/...${CNC}"
    sudo mkdir -p /usr/share/zsh/plugins

    # zsh-autosuggestions — apt instala en /usr/share/zsh-autosuggestions
    if [ -d /usr/share/zsh-autosuggestions ]; then
        run sudo ln -sf /usr/share/zsh-autosuggestions /usr/share/zsh/plugins/zsh-autosuggestions
        log "OK: symlink zsh-autosuggestions creado"
    else
        log "AVISO: /usr/share/zsh-autosuggestions no encontrado, saltando symlink"
    fi

    # zsh-syntax-highlighting — apt instala en /usr/share/zsh-syntax-highlighting
    if [ -d /usr/share/zsh-syntax-highlighting ]; then
        run sudo ln -sf /usr/share/zsh-syntax-highlighting /usr/share/zsh/plugins/zsh-syntax-highlighting
        log "OK: symlink zsh-syntax-highlighting creado"
    else
        log "AVISO: /usr/share/zsh-syntax-highlighting no encontrado, saltando symlink"
    fi

    # zsh-history-substring-search — clonado en ~/.local/share/
    if [ -d "$zhs_dir" ]; then
        run sudo ln -sf "$zhs_dir" /usr/share/zsh/plugins/zsh-history-substring-search
        log "OK: symlink zsh-history-substring-search creado"
    else
        log "AVISO: $zhs_dir no encontrado, saltando symlink"
    fi

    printf "%b\n" "${BLD}${CGR}Symlinks de plugins zsh creados.${CNC}"
    sleep 3
}

# ─────────────────────────────────────────────────────────────────
clone_dotfiles() {
    clear
    logo "Descargando dotfiles"
    repo_url="https://github.com/gh0stzk/dotfiles"
    repo_dir="$HOME/.local/share/gh0stzk"
    timestamp=$(date +"%Y%m%d-%H%M%S")
    sleep 2

    if [ -d "$repo_dir" ]; then
        backup_dir="${repo_dir}_$timestamp"
        printf "%b\n" "${BLD}${CYE}Repositorio existente encontrado - renombrando a: ${CBL}${backup_dir}${CNC}"
        log "Renombrando directorio de dotfiles existente: $repo_dir -> $backup_dir"
        mv -v "$repo_dir" "$backup_dir"
    fi

    printf "%b\n" "${BLD}${CYE}Clonando dotfiles desde: ${CBL}${repo_url}${CNC}"
    log "Clonando dotfiles en $repo_dir"
    run git clone --depth=1 "$repo_url" "$repo_dir"
    sleep 3
}

# ─────────────────────────────────────────────────────────────────
# st comes from https://github.com/gh0stzk/st-terminal (dedicated repo).
# The dotfiles only contain runtime st configs (colorscheme, xresources).
# We clone and build from source since the Arch binary is not compatible with Ubuntu.
# Patches included: kitty graphics, boxdraw, xresources, scrollback, ligatures,
# wide glyph, appsync, blinking cursor, desktop entry, drag-n-drop,
# dynamic cursor color, bold-is-not-bright, swap mouse, unfocused cursor.
build_st() {
    clear
    logo "Compilando el terminal st desde fuente..."
    sleep 2

    if command -v st >/dev/null 2>&1; then
        printf "%b\n" "${BLD}${CGR}st ya está instalado.${CNC}"
        log "st ya instalado, saltando compilación."
        sleep 3
        return
    fi

    printf "%b\n" "${BLD}${CYE}Clonando gh0stzk/st-terminal...${CNC}"
    log "Clonando https://github.com/gh0stzk/st-terminal"
    [ -d /tmp/st-terminal ] && rm -rf /tmp/st-terminal

    if ! run git clone --depth=1 https://github.com/gh0stzk/st-terminal /tmp/st-terminal; then
        log "ERROR: fallo al clonar el repo st-terminal"
        printf "%b\n" "${BLD}${CRE}No se pudo clonar st-terminal. Revisa missing_apps.txt${CNC}"
        printf "\nst: fallo al clonar desde https://github.com/gh0stzk/st-terminal\n" >> missing_apps.txt
        sleep 3
        return
    fi

    cd /tmp/st-terminal || { log "ERROR: no se pudo acceder a /tmp/st-terminal"; return 1; }
    printf "%b\n" "${BLD}${CYE}Compilando st...${CNC}"
    log "Ejecutando make en /tmp/st-terminal"

    if run make && run sudo make install; then
        log "OK: st instalado exitosamente"
        printf "%b\n" "${BLD}${CGR}st instalado exitosamente.${CNC}"
    else
        log "ERROR: fallo en la compilación de st — ver log para detalles del compilador"
        printf "%b\n" "${BLD}${CRE}Compilación de st falló. Revisa missing_apps.txt${CNC}"
        printf "\nst: compilación fallida — intentar manualmente:\n  git clone https://github.com/gh0stzk/st-terminal && cd st-terminal && make && sudo make install\n" >> missing_apps.txt
    fi

    cd "$HOME"
    rm -rf /tmp/st-terminal
    sleep 3
}

# ─────────────────────────────────────────────────────────────────
backup_existing_config() {
    clear
    logo "Respaldo de archivos"
    sleep 2

    printf "%b" "Mis dotfiles incluyen una configuración de Neovim ligera, simple y funcional.\nSi ya tienes una configuración personalizada de Neovim y no quieres usar la mía, escribe 'n'\n"

    while :; do
        printf "%b" "${BLD}${CYE}¿Quieres usar mi configuración de Neovim? ${CNC}[y/N]: "
        read -r try_nvim
        log_input "backup/use_nvim" "$try_nvim"
        case "$try_nvim" in
            [Yy]) try_nvim="y"; break ;;
            [Nn]) try_nvim="n"; break ;;
            *) printf " %b%bError:%b escribe 'y' o 'n'\n" "${BLD}" "${CRE}" "${CNC}" ;;
        esac
    done

    backup_folder="$HOME/.RiceBackup/$(date +%Y%m%d-%H%M%S)"
    mkdir -p "$backup_folder"
    log "Carpeta de respaldo: $backup_folder"
    printf "\n%b\n\n" "${BLD}${CYE}Directorio de respaldo: ${CBL}$backup_folder${CNC}"
    sleep 1

    cfg_dir="bspwm alacritty clipcat picom rofi eww sxhkd dunst kitty polybar geany gtk-3.0 ncmpcpp yazi zsh mpd"
    for cfg in $cfg_dir; do
        if [ -d "$HOME/.config/$cfg" ]; then
            log "Respaldando ~/.config/$cfg"
            mv "$HOME/.config/$cfg" "$backup_folder"
        fi
    done

    for f in ".icons" ".zshrc" ".gtkrc-2.0"; do
        if [ -e "$HOME/$f" ]; then
            log "Respaldando ~/$f"
            mv "$HOME/$f" "$backup_folder"
        fi
    done

    if [ "$try_nvim" = "y" ] && [ -d "$HOME/.config/nvim" ]; then
        log "Respaldando ~/.config/nvim"
        mv "$HOME/.config/nvim" "$backup_folder"
    fi

    printf "\n%b\n\n" "${BLD}${CGR}Todos los archivos movidos a:${CNC} ${BLD}${CYE}$backup_folder${CNC}"
    sleep 3
}

# ─────────────────────────────────────────────────────────────────
install_dotfiles() {
    clear
    logo "Instalando dotfiles.."
    printf "%s%s Copiando archivos a sus directorios correspondientes...%s\n\n" "$BLD" "$CBL" "$CNC"
    sleep 2

    for dir in "$HOME/.config" "$HOME/.local/bin" "$HOME/.local/share"; do
        if [ ! -d "$dir" ]; then
            mkdir -p "$dir"
            log "Directorio creado: $dir"
            printf "%s%sCreated directory: %s%s%s\n" "$BLD" "$CGR" "$CBL" "$dir" "$CNC"
        fi
    done

    # Notes:
    #   paru    — Arch AUR helper, omitted
    #   eww     — lives inside config/bspwm/eww/, copied automatically with bspwm
    #   picom, rofi, sxhkd, dunst — inside config/bspwm/config/, no top-level dir
    dots_config_dir="alacritty bspwm clipcat geany gtk-3.0 kitty mpd ncmpcpp yazi zsh"
    for dots_cfg in $dots_config_dir; do
        src="$HOME/.local/share/gh0stzk/config/$dots_cfg"
        if [ -d "$src" ]; then
            cp -R "$src" "$HOME/.config/"
            log "Config copiada: $dots_cfg"
        else
            log "AVISO: directorio de config no encontrado en dotfiles: $src"
        fi
    done

    # systemd: copy user units but strip Arch-specific ArchUpdates files
    systemd_src="$HOME/.local/share/gh0stzk/config/systemd"
    if [ -d "$systemd_src" ]; then
        mkdir -p "$HOME/.config/systemd/user"
        find "$systemd_src" -type f \
            ! -name "ArchUpdates.service" \
            ! -name "ArchUpdates.timer" | while read -r unit; do
            cp "$unit" "$HOME/.config/systemd/user/"
            log "Unidad systemd copiada: $(basename "$unit")"
        done
        log "Omitidos ArchUpdates.service y ArchUpdates.timer (específicos de Arch)"
    else
        log "AVISO: directorio systemd no encontrado: $systemd_src"
    fi

    if [ "$try_nvim" = "y" ]; then
        src="$HOME/.local/share/gh0stzk/config/nvim"
        [ -d "$src" ] && cp -R "$src" "$HOME/.config/" && log "Config copiada: nvim"
    fi

    dots_misc_dir="applications asciiart fonts"
    for dots_misc in $dots_misc_dir; do
        src="$HOME/.local/share/gh0stzk/misc/$dots_misc"
        if [ -d "$src" ]; then
            cp -R "$src" "$HOME/.local/share/"
            log "Misc copiado: $dots_misc"
        else
            log "AVISO: directorio misc no encontrado: $src"
        fi
    done

    src="$HOME/.local/share/gh0stzk/misc/bin"
    if [ -d "$src" ]; then
        cp -R "$src" "$HOME/.local/"
        log "Directorio bin copiado"
    else
        log "AVISO: directorio bin no encontrado: $src"
    fi

    # Note: home/ is empty in the current dotfiles repo.
    # .zshrc, .gtkrc-2.0 and .icons may be generated or added later by the user.
    dots_home_dir=".icons .zshrc .gtkrc-2.0"
    home_dir="$HOME/.local/share/gh0stzk/home"
    found_any=0
    for dots_home in $dots_home_dir; do
        src="${home_dir}/${dots_home}"
        if [ -e "$src" ]; then
            cp -R "$src" "$HOME/"
            log "Copied home file: $dots_home"
            found_any=1
        else
            log "INFO: home/$dots_home no presente en dotfiles (home/ vacío en esta versión del repo) — saltando"
        fi
    done
    if [ "$found_any" = "0" ]; then
        printf "%b\n" "${BLD}${CYE}Nota: el directorio home/ está vacío en el repo — .zshrc/.icons/.gtkrc-2.0 no copiados.${CNC}"
    fi

    # Note: polybar-update.hook is pacman-specific; omitted on Ubuntu.

    run fc-cache -r
    log "Caché de fuentes actualizado"

    if [ ! -e "$HOME/.config/user-dirs.dirs" ]; then
        run xdg-user-dirs-update
    fi

    printf "\n%s%s¡Dotfiles instalados exitosamente!%s\n" "$BLD" "$CGR" "$CNC"
    sleep 3
}

# ─────────────────────────────────────────────────────────────────
configure_services() {
    clear
    logo "Configurando Servicios"
    picom_config="$HOME/.config/bspwm/config/picom.conf"
    sleep 2

    if systemctl is-enabled --quiet mpd.service 2>/dev/null; then
        printf "%b\n" "${BLD}${CYE}Deshabilitando servicio MPD global...${CNC}"
        log "Deshabilitando servicio mpd.service del sistema"
        run sudo systemctl disable --now mpd.service
    fi

    printf "%b\n" "${BLD}${CYE}Habilitando servicio MPD de usuario...${CNC}"
    log "Habilitando mpd.service de usuario"
    if ! systemctl --user enable --now mpd.service 2>> "$LOG_FILE"; then
        log "AVISO: fallo al habilitar mpd.service de usuario — puede requerir habilitación manual tras reinicio"
        printf "%b\n" "${BLD}${CYE}Servicio MPD de usuario no disponible aún, puede requerir habilitación manual tras reinicio.${CNC}"
    fi

    # Note: ArchUpdates.timer is Arch-specific; omitted on Ubuntu.

    is_virtual_machine() {
        systemd-detect-virt --quiet >/dev/null 2>&1
    }

    if is_virtual_machine; then
        virt_type=$(systemd-detect-virt 2>/dev/null)
        log "Máquina virtual detectada: $virt_type — ajustando config de picom"
        printf "%b\n" "${BLD}${CYE}Máquina virtual detectada${CNC}"
        printf "\n%b\n" "${BLD}${CYE}Ajustando configuración de Picom...${CNC}"

        if [ -f "$picom_config" ]; then
            if run sed -i 's/backend = "glx"/backend = "xrender"/' "$picom_config"; then
                printf "%b\n" "${BLD}${CGR}Backend de Picom cambiado a xrender${CNC}"
            else
                log "ERROR: fallo al configurar el backend de picom"
                printf "%b\n" "${BLD}${CRE}Fallo al ajustar configuración de Picom${CNC}"
            fi
            if run sed -i 's/vsync = true/vsync = false/' "$picom_config"; then
                printf "%b\n\n" "${BLD}${CGR}vSync de Picom deshabilitado${CNC}"
            else
                log "ERROR: fallo al deshabilitar vsync de picom"
                printf "%b\n\n" "${BLD}${CRE}Fallo al ajustar configuración de Picom${CNC}"
            fi
        else
            log "AVISO: config de picom no encontrada en $picom_config"
            printf "%b\n\n" "${BLD}${CRE}Archivo de config de Picom no encontrado: ${CYE}${picom_config}${CNC}"
        fi
    fi
    sleep 3
}

# ─────────────────────────────────────────────────────────────────
change_default_shell() {
    clear
    logo "Cambiando el shell predeterminado a zsh"
    zsh_path=$(command -v zsh)
    sleep 2

    log "Ruta de zsh: $zsh_path  SHELL actual: $SHELL"

    if [ -z "$zsh_path" ]; then
        log "ERROR: zsh no encontrado, no se puede cambiar el shell"
        printf "%b\n\n" "${BLD}${CRE}¡Zsh no está instalado! No se puede cambiar el shell${CNC}"
        return
    fi

    if [ "$SHELL" != "$zsh_path" ]; then
        printf "%b\n" "${BLD}${CYE}Cambiando tu shell a Zsh...${CNC}"
        if run chsh -s "$zsh_path"; then
            log "Shell cambiado a $zsh_path"
            printf "%b\n" "\n${BLD}${CGR}¡Shell cambiado exitosamente!${CNC}"
        else
            log "ERROR: fallo en chsh"
            printf "%b\n\n" "\n${BLD}${CRE}¡Error al cambiar el shell!${CNC}"
        fi
    else
        log "Zsh ya es el shell predeterminado."
        printf "%b\n\n" "${BLD}${CGR}¡Zsh ya es tu shell predeterminado!${CNC}"
    fi
    sleep 3
}

# ─────────────────────────────────────────────────────────────────
final_prompt() {
    clear
    logo "Instalación Completa"

    # Mover missing_apps.txt a ~/Entorno si existe
    if [ -f "$HOME/missing_apps.txt" ]; then
        mv "$HOME/missing_apps.txt" "$HOME/Entorno/missing_apps.txt"
        log "missing_apps.txt movido a ~/Entorno/"
    fi

    log "====== Instalación completa ======"
    log "Archivos de instalación guardados en: $HOME/Entorno/"

    printf "%b\n"   "${BLD}${CGR}¡Instalación completada exitosamente!${CNC}"
    printf "%b\n"   "${BLD}${CBL}Logs e informes guardados en: ${CYE}~/Entorno/${CNC}"
    [ -f "$HOME/Entorno/missing_apps.txt" ] && \
        printf "%b\n" "${BLD}${CRE}Algunos paquetes fallaron — ver: ${CYE}~/Entorno/missing_apps.txt${CNC}"
    printf "%b\n\n" "${BLD}${CRE}DEBES ${CBL}reiniciar ${CRE}tu sistema para aplicar los cambios${CNC}"

    while :; do
        printf "%b" "${BLD}${CYE}¿Reiniciar ahora?${CNC} [y/N]: "
        read -r yn
        log_input "final/reboot" "$yn"
        case "$yn" in
            [Yy]) printf "\n%b\n" "${BLD}${CGR}Iniciando reinicio...${CNC}"
                log "El usuario eligió reiniciar."
                sleep 1
                sudo reboot
                break ;;
            [Nn]|"") printf "\n%b\n\n" "${BLD}${CYE}¡De verdad necesitas reiniciar!${CNC}"
                    log "El usuario omitió el reinicio."
                    break ;;
            *) printf " %b%bError:%b escribe 'y' o 'n'\n" "${BLD}" "${CRE}" "${CNC}" ;;
        esac
    done
}

