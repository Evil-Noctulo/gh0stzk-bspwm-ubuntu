# ─────────────────────────────────────────────────────────────────
#  CONFIGURACIÓN DE LOGGING
#  Cada comando ejecutado, su salida completa (stdout+stderr), código de salida
#  y cada input del usuario se escribe en LOG_FILE en texto plano.
#  El terminal sigue mostrando la salida normal con colores.
# ─────────────────────────────────────────────────────────────────
mkdir -p "$HOME/Entorno"
LOG_FILE="$HOME/Entorno/rice-installer-$(date +%Y%m%d-%H%M%S).log"

# Duplicate all stdout/stderr to LOG_FILE, stripping ANSI color codes so
# el log es legible sin secuencias de escape.
exec > >(tee >(sed -u 's/\x1b\[[0-9;]*[mGKHF]//g; s/\x1b\[?[0-9]*[hl]//g' \
    >> "$LOG_FILE")) 2>&1

# log MENSAJE — escribe una línea con timestamp en LOG_FILE.
log() {
    printf "[%s] %s\n" "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG_FILE"
}

# log_input NOMBRE VALOR — registra lo que el usuario escribió en un prompt.
log_input() {
    log "USER_INPUT [$1]: '$2'"
}

# run CMD [ARGS...] — registra el comando y código de salida, luego lo ejecuta.
# stdout/stderr van al terminal Y al LOG_FILE automáticamente via el exec tee.
run() {
    log "RUN: $*"
    "$@"
    local rc=$?
    log "EXIT_CODE=$rc for: $*"
    return $rc
}

# Captura salidas inesperadas y las registra en el log.
trap 'log "UNEXPECTED EXIT (code $?) at line $LINENO — check above for the last RUN entry."' ERR

log "====== RiceInstaller iniciado — usuario: $USER  pwd: $PWD ======"
log "Versión de Ubuntu: $(lsb_release -ds 2>/dev/null || cat /etc/os-release | grep PRETTY_NAME | cut -d= -f2)"
log "Bash: $BASH_VERSION"
log "ARCHIVO DE LOG: $LOG_FILE"
printf "\n%s[Archivo de log: %s]%s\n\n" "$(tput setaf 4)$(tput bold)" "$LOG_FILE" "$(tput sgr0)"

# ─────────────────────────────────────────────────────────────────
#  COLORES
# ─────────────────────────────────────────────────────────────────
CRE=$(tput setaf 1)    # Red
CYE=$(tput setaf 3)    # Yellow
CGR=$(tput setaf 2)    # Green
CBL=$(tput setaf 4)    # Blue
BLD=$(tput bold)
CNC=$(tput sgr0)
